{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "Nexora",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "Nexora"
  },
  "runtimes": [
    {
      "name": "NexoraAgent",
      "build": "CodeZip",
      "entrypoint": "runtime.py",
      "codeLocation": "services/agent/",
      "runtimeVersion": "PYTHON_3_13",
      "envVars": [
        {
          "name": "NEXORA_AWS_ENABLED",
          "value": "true"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "NEXORA_MODEL_ID",
          "value": "global.anthropic.claude-sonnet-4-6"
        }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "authorizerType": "AWS_IAM"
    }
  ],
  "memories": [
    {
      "name": "NexoraLearningMemory",
      "eventExpiryDuration": 90,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
